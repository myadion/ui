{
  "name": "@myadion/ui",
  "version": "0.3.29",
  "description": "Les composants et gabarits d'Adion Cloud pour Vue 3 et Vuetify 3.",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myadion/ui.git",
    "directory": "packages/vue"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "README.md"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./base.css": "./src/base.css",
    "./ui.css": "./src/ui.css",
    "./content.css": "./src/content.css",
    "./*": "./src/*"
  },
  "peerDependencies": {
    "@myadion/tokens": "^0.1.0",
    "three": ">=0.160.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "vuetify": "^3.8.0"
  },
  "scripts": {
    "test": "node --test \"src/*.test.js\"",
    "prepublishOnly": "node --test \"src/*.test.js\""
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/myadion/ui",
  "keywords": [
    "adion",
    "design-system",
    "ui"
  ],
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  }
}
